+            synergy_sum += w_omega * (pillar_convictions[p1] * pillar_convictions[p2])
+
+        # Maximum synergy capped at 10.0% (1.100x multiplier)
+        synergy_multiplier = 1.0 + synergy_sum.clip(0.0, 0.100)
+        return synergy_multiplier
