# =================================================================
# 주식 트레이딩 시스템 - 환경 설정 템플릿 (.env.example)
#
# 이 파일을 복사하여 '.env' 파일을 생성하고, 각 변수의 실제값을 입력하세요.
# =================================================================

# 1. AI/LLM API 설정
# 사용할 LLM 제공자 선택 (openai 또는 gemini)
LLM_PROVIDER=openai

# OpenAI 설정 (LLM_PROVIDER=openai 인 경우)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API 설정 (LLM_PROVIDER=gemini 인 경우)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# 2. 텔레그램 봇 설정
# @BotFather를 통해 발급받은 텔레그램 봇 API 토큰
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. 디버그 및 로깅 설정
DEBUG_MODE=True
LOG_LEVEL=INFO
