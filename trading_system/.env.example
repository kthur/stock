# =================================================================
# 주식 트레이딩 및 AI 예측 시스템 - 환경 설정 템플릿
#
# 사용법: cp .env.example .env → 실제 값으로 변경
# =================================================================

# 1. 시스템 및 데이터베이스 설정
DB_PATH=market_indicators.db
BACKTEST_YEARS=30
STOCK_PRICE_DB_PATH=stock_prices.db
STOCK_PRICE_FRESHNESS_DAYS=7

DEBUG_MODE=True
LOG_LEVEL=INFO

# 2. 데이터 수집 설정
UPDATE_INTERVAL=15
INFERENCE_TARGET=SP500,KRX

# 3. AI 모델 예측 설정
TRAIN_SEED=42
TRAIN_SAMPLE_SP500=all
TRAIN_SAMPLE_KRX=all
TRAIN_START_DATE=2006-01-01

# 4. 브로커 설정 (KIS 한국투자증권)
BROKER_TYPE=KIS
MOCK_TRADING_ENABLED=True

KIS_MOCK_APP_KEY=your_kis_mock_app_key_here
KIS_MOCK_APP_SECRET=your_kis_mock_app_secret_here
KIS_MOCK_ACCOUNT=your_kis_mock_account_here

# 5. AI/LLM API 설정
LLM_PROVIDER=gemini

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 6. 텔레그램 알림 설정
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_USER_IDS=your_telegram_user_id_here
